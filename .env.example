# BeverageTrack AI - Supabase & Production Configuration Example
PROJECT_NAME="BeverageTrack AI"
VERSION="1.0.0"
ENVIRONMENT="production"

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SUPABASE_SECRET_KEY="your-secret-key"

# Supabase PostgreSQL Connection
POSTGRES_DATABASE="postgres"
POSTGRES_USER="postgres"
POSTGRES_HOST="db.your-project.supabase.co"
POSTGRES_PASSWORD="your-db-password"

DATABASE_URL="postgresql+pg8000://postgres.your-project:your-password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

SECRET_KEY="your-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_PORT=8000
FRONTEND_PORT=3000
